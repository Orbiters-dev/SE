+def test_collab_type_is_canonicalized_after_the_key():
+    """collab_type 정규화(有償→Paid)는 **키 계산 뒤** — 키는 원문 기준으로 불변이어야 한다.
+
+    빨개지는 입력: 정규화를 `_source_row_key` 앞으로 옮기면 기대 키(원문 有償 basis)와
+    달라진다 — 기존 행이 전부 새 키로 재적재되는 사고 축이다.
+    """
+    rec = _collab_rec("有償")
+    assert rec["collab_type"] == "Paid"
+    expected = c._source_row_key(
+        {
+            "drive_file_id": "FID",
+            "drive_url": "https://d/file/d/FID/view",
+            "featured_brand_raw": "G",
+            "collab_type": "有償",
+            "email": "a@b.com",
+        }
+    )
+    assert rec["source_row_key"] == expected
+    assert rec["raw_payload"]["collab_type"] == "有償", "원문이 raw_payload 에 안 남았다"
